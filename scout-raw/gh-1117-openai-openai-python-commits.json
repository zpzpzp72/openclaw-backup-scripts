[{"sha":"33949560b1429eb56b2e26cc88350cefc22d2789","node_id":"C_kwDOEk-zddoAKDMzOTQ5NTYwYjE0MjllYjU2YjJlMjZjYzg4MzUwY2VmYzIyZDI3ODk","commit":{"author":{"name":"Dan Piet","email":"dp@openai.com","date":"2026-11-16T16:56:15Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-11-16T16:56:15Z"},"message":"ci: run Python 3.9 resolver check on Ubuntu 24.04 (#4277)\n\n## Summary\n\nPin the build job to Ubuntu 24.04. Ubuntu 26.04 is rolling out under\n`ubuntu-latest`, and `actions/setup-python` has no Python 3.9 x64\nartifact for that image. Ubuntu 24.04 still has one, so the build can\ncontinue verifying that Python 3.9 rejects the wheel.\n\n## Validation\n\n- Parsed both versions of the workflow and verified that the build\nrunner label is the only configuration change.\n- Confirmed Ubuntu 24.04 x64 availability in the [Python versions\nmanifest](https://raw.githubusercontent.com/actions/python-versions/main/versions-manifest.json).","tree":{"sha":"178ed8e18e669ec6670f9847f4d7b7ccb163cb51","url":"https://api.github.com/repos/openai/openai-python/git/trees/178ed8e18e669ec6670f9847f4d7b7ccb163cb51"},"url":"https://api.github.com/repos/openai/openai-python/git/commits/33949560b1429eb56b2e26cc88350cefc22d2789","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJq+zXACRC1aQ7uu5UhlAAAN+YQAC10wiQ4KFjP+FZ4gNZVAO0x\nrCjvrjuZZUKCM8kg4pF/vvXRnHaq3d9TR2MSClguJIPiwpD8ABHUMoCnwER7F2KJ\ngpC0BwwnIckdvoB0UXtPEmAPc0FEykbA7+tfVz4uwOeWomIV7oRN047rcMShz3HU\nwSA2sVluPn8tZXH0hBuzQJ73BW/tAEo5SQuenLRbc/ARSHZJDM1cJVdpxzjFA3V7\nS/dIpBEQhXpmn4F5SmwtIYiHFfiE4GH8Wso+BT/tumn7841X/IeKWLlWMKOvP8Zj\nUAe4ebk9YROhkD1HdLZ/CFzfCmXqviRFBFj+a3WOACU2WH7FRZ1qg7e49QLZgy9l\nyRQw+abisK/9KU9F3lFXMW9ORIPAMjKaGF7RAimlf4IGrgoumNMDKoavWkqrdUL7\nvjHU8VKYUC+n9w8vrm1Slr9eQujdVm7KQTgKi0dL0Z1QFuwn+hafRsvDQufjV9mU\n9LtJnSs/BIe35EFGIKUUpQ8FRyfv9V9Y9/JbgCt9vgbRN70l3Lfr9nEXvkTrL/vx\nJyXlqeV75RPdbsNmrvsXZDb41EDFQ8+Bh0dm2lMoyUufek6eu0JgfDSaXCATvG+y\n+zInTIs7v0DfBEbdkHHh06Veg2n9myYooCjHmgyJ+Tn5pDuAGH4/8Szgjyb4lkRp\ndTB9Q+7tsbrVpR331bZ8\n=ADFa\n-----END PGP SIGNATURE-----\n","payload":"tree 178ed8e18e669ec6670f9847f4d7b7ccb163cb51\nparent 3dae6090cc31cc64a437fe0bcee740b6d81ed2cc\nauthor Dan Piet <dp@openai.com> 1794848175 +0000\ncommitter GitHub <noreply@github.com> 1794848175 +0000\n\nci: run Python 3.9 resolver check on Ubuntu 24.04 (#4277)\n\n## Summary\n\nPin the build job to Ubuntu 24.04. Ubuntu 26.04 is rolling out under\n`ubuntu-latest`, and `actions/setup-python` has no Python 3.9 x64\nartifact for that image. Ubuntu 24.04 still has one, so the build can\ncontinue verifying that Python 3.9 rejects the wheel.\n\n## Validation\n\n- Parsed both versions of the workflow and verified that the build\nrunner label is the only configuration change.\n- Confirmed Ubuntu 24.04 x64 availability in the [Python versions\nmanifest](https://raw.githubusercontent.com/actions/python-versions/main/versions-manifest.json).","verified_at":"2026-11-16T16:56:32Z"}},"url":"https://api.github.com/repos/openai/openai-python/commits/33949560b1429eb56b2e26cc88350cefc22d2789","html_url":"https://github.com/openai/openai-python/commit/33949560b1429eb56b2e26cc88350cefc22d2789","comments_url":"https://api.github.com/repos/openai/openai-python/commits/33949560b1429eb56b2e26cc88350cefc22d2789/comments","author":{"login":"dpiet-oai","id":326640584,"node_id":"U_kgDOE3gjyA","avatar_url":"https://avatars.githubusercontent.com/u/326640584?v=4","gravatar_id":"","url":"https://api.github.com/users/dpiet-oai","html_url":"https://github.com/dpiet-oai","followers_url":"https://api.github.com/users/dpiet-oai/followers","following_url":"https://api.github.com/users/dpiet-oai/following{/other_user}","gists_url":"https://api.github.com/users/dpiet-oai/gists{/gist_id}","starred_url":"https://api.github.com/users/dpiet-oai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dpiet-oai/subscriptions","organizations_url