[{"by": "mday404", "descendants": 37, "id": 50667726, "kids": [50668037, 50668451, 50668694, 50668674, 50668483, 50667889, 50668637, 50668346, 50668217, 50667849, 50668059, 50668054, 50668043, 50668007, 50668184, 50667972, 50667813, 50668064, 50668112, 50668096, 50668367, 50668258, 50668604, 50668083, 50668006], "score": 110, "text": "a ball will fall. trade on where it lands.<p>I made this game! Some technical details:<p>The entire drop of the ball is simulated server-side, then streamed to each client as server-sent events with a small buffer. Every drop is deterministic from its starting position, so rounds can be replayed exactly for later analysis, but tiny variations in starting position can change the ultimate outcome.<p>There&#x27;s some AI traders to keep the market moving, but they drop out in any round that has more than five people. They operate using a naive set of rules that I wrote for them, so they&#x27;re not too hard to beat -- it&#x27;s when the market is full of real people that it gets tricky.<p>Curious to get feedback on anything you would change, and especially whether the mechanics were clear right away or not.", "time": 1795791710, "title": "Show HN: bouncemarket – a live prediction market game for a bouncing ball", "type": "story", "url": "https://bouncemarket.minhanhday.com/"}, {"by": "Bender", "descendants": 24, "id": 50657392, "kids": [50667968, 50667715, 50667899], "score": 96, "time": 1795713877, "title": "First images of the impact of DART asteroid deflection experiment", "type": "story", "url": "https://arstechnica.com/space/2026/11/europes-hera-mission-returns-to-the-chaotic-scene-of-a-cosmic-smashup/"}, {"by": "scanr", "descendants": 7, "id": 50668145, "kids": [50668701, 50668592, 50668579, 50668191, 50668600], "score": 27, "time": 1795794031, "title": "Credit card skimming scripts using WebRTC found on popular shopping sites", "type": "story", "url": "https://www.infohawk.com/news/2026-11-27-black-friday-webrtc-skimmer"}, {"by": "