/users/koic/events{/privacy}","received_events_url":"https://api.github.com/users/koic/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"0e59bb4c513930112845434f328e90eb1ff67908","url":"https://api.github.com/repos/modelcontextprotocol/ruby-sdk/commits/0e59bb4c513930112845434f328e90eb1ff67908","html_url":"https://github.com/modelcontextprotocol/ruby-sdk/commit/0e59bb4c513930112845434f328e90eb1ff67908"},{"sha":"e757931a233e8ea238ce4d2f819ce96ce4e797f0","url":"https://api.github.com/repos/modelcontextprotocol/ruby-sdk/commits/e757931a233e8ea238ce4d2f819ce96ce4e797f0","html_url":"https://github.com/modelcontextprotocol/ruby-sdk/commit/e757931a233e8ea238ce4d2f819ce96ce4e797f0"}]},{"sha":"93787f0b24c4dd7e6229ebabb58867a2e1c30724","node_id":"C_kwDOOArzItoAKDkzNzg3ZjBiMjRjNGRkN2U2MjI5ZWJhYmI1ODg2N2EyZTFjMzA3MjQ","commit":{"author":{"name":"Koichi ITO","email":"koic.ito@gmail.com","date":"2026-10-22T15:24:28Z"},"committer":{"name":"Koichi ITO","email":"koic.ito@gmail.com","date":"2026-10-22T15:36:39Z"},"message":"Answer an HTTP request whose reply cannot be generated with Internal error\n\n## Motivation and Context\n\nA response can hold a string that is not valid UTF-8 when the request carried one and the SDK or a handler\nrepeated it, for example a tool name in its `Tool not found` error, since the JSON parser passes such bytes in\na string value through. Generating that response raised `JSON::GeneratorError`. On the Streamable HTTP legacy\npath the error escaped while the SSE body was being written, cutting the response off; in JSON response mode\nand on the 2026-07-28 path the transport's rescue answered 500 with the error reported, for a failure that\nbelongs to the one request.\n\n`JsonRpcHandler.handle_json` now answers such a request with `-32603` Internal error carrying the request id, and\nthe 2026-07-28 path does the same before it writes the response.\n\nThe error carries the request id when the response has one. In a batch each item that cannot be generated is\nreplaced on its own, so the other items keep their results. The failure is passed to the exception reporter,\nsince the Internal error sent to the client no longer shows what went wrong.\nOver stdio a batch is now answered by `handle_json` as well, with the request id, ahead of the transport's own\nfallback, which answered it without one.\n\n## How Has This Been Tested?\n\n`test/json_rpc_handler_test.rb` and `test/mcp/server/transports/streamable_http_transport_test.rb` (the legacy\nSSE path, JSON response mode, and the 2026-07-28 path, each with a tool whose reply cannot be generated).\nAgainst the previous library the handler test raises `JSON::GeneratorError`, the SSE body raises it while it is\nwritten, and the other two answer 500.\n\nThe handler test for a batch in which one item cannot be generated fails against the previous library, which\nhas no `on_generate_error:`. The transport tests check that the failure reaches the exception reporter.\nThe stdio batch test expects the item's id accordingly.\n\n## Breaking Changes\n\nNone.","tree":{"sha":"b6cf0a1f9f73559c855a5708d15df16c4f34d14f","url":"https://api.github.com/repos/modelcontextprotocol/ruby-sdk/git/trees/b6cf0a1f9f73559c855a5708d15df16c4f34d14f"},"url":"https://api.github.com/repos/modelcontextprotocol/ruby-sdk/git/commits/93787f0b24c4dd7e6229ebabb58867a2e1c30724","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/modelcontextprotocol/ruby-sdk/commits/93787f0b24c4dd7e6229ebabb58867a2e1c30724","html_url":"https://github.com/modelcontextprotocol/ruby-sdk/commit/93787f0b24c4dd7e6229ebabb58867a2e1c30724","comments_url":"https://api.github.com/repos/modelcontextprotocol/ruby-sdk/commits/93787f0b24c4dd7e6229ebabb58867a2e1c30724/comments","author":{"login":"koic","id":13203,"node_id":"MDQ6VXNlcjEzMjAz","avatar_url":"https://avatars.githubusercontent.com/u/13203?v=4","gravatar_id":"","url":"https://api.github.com/users/koic","html_url":"https://github.com/koic","followers_url":"https://api.github.com/users/koic/followers","following_url":"https://api.github.com/users/koic/following{/other_user}","gists_url":"https://api.github.com/users/koic/gists{/gist_id}","starred_url":"https://api.github.com/users/koic/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/koic/subscriptions","organizations_url":"https://api.github.com/users/koic/orgs","repos_url":"https://api.github.com/users/koic/repos","events_url":"https://api.github.com/users/koic/events{/privacy}","received_events_url":"https://api.github.com/users/koic/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"koic","id":13203,"node_id":"MDQ6VXNlcjEzMjAz","avatar_url":"https://avatars.githubusercontent.com/u/13203?v=4","gravatar_id":"","url":"https://api.github.com/users/koic","html_url":"https://github.com/koic","followers_url":"https://api.github.com/users/koic/followers","following_url":"https://api.github.com/users/koic/following{/other_user}","gists_url":"https://api.github.com/users/koic/gists{/gist_id}","starred_url":"https://api.github.com/users/koic/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/koic/subscriptions","organizations_url":"https://api.github.com/users/koic/orgs","repos_url":"https://api.github.com/users/koic/repos","events_url":"https://api.github.com/users/koic/events{/privacy}","received_events_url":"https://api.github.com/users/koic/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"0e59bb4c513930112845434f328e90eb1ff67908","url":"https://api.github.com/repos/modelcontextprotocol/ruby-sdk/commits/0e59bb4c513930112845434f328e90eb1ff67908","html_url":"https://github.com/modelcontextprotocol/ruby-sdk/commit/0e59bb4c513930112845434f328e90eb1ff67908"}]},{"sha":"42e8cd59acc9d50bf902a732513a0caaa4561a86","node_id":"C_kwDOOArzItoAKDQyZThjZDU5YWNjOWQ1MGJmOTAyYTczMjUxM2EwY2FhYTQ1NjFhODY","commit":{"author":{"name":"Koichi ITO","email":"koic.ito@gmail.com","date":"2026-10-22T03:00:56Z"},"committer":{"name":"Koichi ITO","email":"koic.ito@gmail.com","date":"2026-10-22T03:01:04Z"},"message":"Skip a stdio ping whose id cannot be encoded\n\n## Motivation and Context\n\n`MCP::Client::Stdio` answers a server's `ping` inline while it waits for a response, and it already skips a ping\nwhose id is not a JSON-RPC id. A String id holding bytes that are not valid UTF-8 passed that check, and the pong\nechoing it failed in `JSON.generate` with `JSON::GeneratorError`. The pong's own rescue covers only a pong that\ncannot be written, so the error escaped and failed the unrelated request whose response the loop was reading.\n\nSuch a ping is now skipped like one with a malformed id, since a pong could not carry the id back.\n\nA number such as `1e400` fails the same way: the parser reads it as an infinite Float, which `JSON.generate`\nrefuses, so a ping carrying one is skipped as well. A String id that is not valid UTF-8 can arrive in\na plain ASCII frame too: the json gem's 2.x releases decode a lone surrogate escape into one.\n\n## How Has This Been Tested?\n\n`test/mcp/client/stdio_test.rb`: a ping whose id is not valid UTF-8 is not answerable, and one with a valid id\nstill is. Against the previous library the first is answerable.\nA ping whose id is `1e400`, sent ahead of the awaited response, is not answered and the request completes;\nagainst the previous library it raises `JSON::GeneratorError`.\n\n## Breaking Changes\n\nNone.","tree":{"sha":"b910d6454c57a5b26d21000b715811c4e4a3885c","url":"https://api.github.com/repos/modelcontextprotocol/ruby-sdk/git/trees/b910d6454c57a5b26d21000b715811c4e4a3885c"},"url":"https://api.github.com/repos/modelcontextprotocol/ruby-sdk/git/commits/42e8cd59acc9d50bf902a732513a0caaa4561a86","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/modelcontextprotocol/ruby-sdk/commits/42e8cd59acc9d50bf902a732513a0caaa4561a86","html_url":"https://github.com/modelcontextprotocol/ruby-sdk/commit/42e8cd59acc9d50bf902a732513a0caaa4561a86","comments_url":"https://api.github.com/repos/modelcontextprotocol/ruby-sdk/commits/42e8cd59acc9d50bf902a732513a0caaa4561a86/comments","author":{"login":"koic","id":13203,"node_id":"MDQ6VXNlcjEzMjAz","avatar_url":"https://avatars.githubusercontent.com/u/13203?v=4","gravatar_id":"","url":"https://api.github.com/users/koic","html_url":"https://github.com/koic","followers_url":"https://api.github.com/users/koic/followers","following_url":"https://api.github.com/users/koic/following{/other_user}","gists_url":"https://api.github.com/users/koic/gists{/gist_id}","starred_url":"https://api.github.com/users/koic/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/koic/subscriptions","organizations_url":"https://api.github.com/users/koic/orgs","repos_url":"https://api.github.com/users/koic/repos","events_url":"https://api.github.com/users/koic/events{/privacy}","received_events_url":"https://api.github.com/users/koic/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"koic","id":13203,"node_id":"MDQ6VXNlcjEzMjAz","avatar_url":"https://avatars.githubusercontent.com/u/13203?v=4","gravatar_id":"","url":"https://api.github.com/users/koic","html_url":"https://github.com/koic","followers_url":"https://api.github.com/users/koic/followers","following_url":"https://api.github.com/users/koic/following{/other_user}","gists_url":"https://api.github.com/users/koic/gists{/gist_id}","starred_url":"https://api.github.com/users/koic/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/koic/subscriptions","organizations_url":"https://api.github.com/users/koic/orgs","repos_url":"https://api.github.com/users/koic/repos","events_url":"https://api.github.com/users/koic/events{/privacy}","received_events_url":"https://api.github.com/users/koic/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"0e59bb4c513930112845434f328e90eb1ff67908","url":"https://api.github.com/repos/modelcontextprotocol/ruby-sdk/commits/0e59bb4c513930112845434f328e90eb1ff67908","html_url":"https://github.com/modelcontextprotocol/ruby-sdk/commit/0e59bb4c513930112845434f328e90eb1ff67908"}]},{"sha":"e757931a233e8ea238ce4d2f819ce96ce4e797f0","node_id":"C_kwDOOArzItoAKGU3NTc5MzFhMjMzZThlYTIzOGNlNGQyZjgxOWNlOTZjZTRlNzk3ZjA","commit":{"author":{"name":"Koichi ITO","email":"koic.ito@gmail.com","date":"2026-10-21T15:05:08Z"},"committer":{"name":"Koichi ITO","email":"koic.ito@gmail.com","date":"2026-10-21T15:05:08Z"},"message":"Strip stdio client frames as bytes\n\n## Motivation and Context\n\n`MCP::Client::Stdio` reads the server's stdout as UTF-8 and strips each frame before parsing it. `String#strip`\nraises for a UTF-8 string holding an invalid byte at either end on every supported Ruby, and anywhere in it from\nRuby 3.2 on, and the read loop rescued only `JSON::ParserError`. A server writing such a frame therefore failed\nthe awaited request with `ArgumentError` or `Encoding::CompatibilityError` instead of the transport's own\n`RequestHandlerError`, which callers rescue. The server transport strips its frames the same way and has the same\nchange separately.\n\nFrames are now stripped as bytes. A frame that is not JSON fails the request with the transport's parse failure,\nas any other unparsable frame does, and a response holding such a byte in a value is returned with the byte kept.\n\n## How Has This Been Tested?\n\n`test/mcp/client/stdio_test.rb`: a frame starting with an invalid byte and a response holding one in a value.\nAgainst the previous library the first raises `ArgumentError` and the second `Encoding::CompatibilityError`.\n\n## Breaking Changes\n\nNone.","tree":{"sha":"f17173fb1a1ede2b7f2a27c74b56d86f3b85367c","url":"https://api.github.com/repos/modelcontextprotocol/ruby-sdk/git/trees/f17173fb1a1ede2b7f2a27c74b56d86f3b85367c"},"url":"https://api.github.com/repos/modelcontextprotocol/ruby-sdk/git/commits/e757931a233e8ea238ce4d2f819ce96ce4e797f0","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/modelcontextprotocol/ruby-sdk/commits/e757931a233e8ea238ce4d2f819ce96ce4e797f0","html_url":"https://github.com/modelcontextprotocol/ruby-sdk/commit/e757931a233e8ea238ce4d2f819ce96ce4e797f0","comments_url":"https://api.github.com/repos/modelcontextprotocol/ruby-sdk/commits/e757931a233e8ea238ce4d2f819ce96ce4e797f0/comments","author":{"login":"koic","id":13203,"node_id":"MDQ6VXNlcjEzMjAz","avatar_url":"https://avatars.githubusercontent.com/u/13203?v=4","gravatar_id":"","url":"https://api.github.com/users/koic","html_url":"https://github.com/koic","followers_url":"https://api.github.com/users/koic/followers","fo