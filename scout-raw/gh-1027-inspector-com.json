hall/events{/privacy}","received_events_url":"https://api.github.com/users/cliffhall/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"63c5a06cf4c0373b5d044f2018bb6e1987c77f29","url":"https://api.github.com/repos/modelcontextprotocol/inspector/commits/63c5a06cf4c0373b5d044f2018bb6e1987c77f29","html_url":"https://github.com/modelcontextprotocol/inspector/commit/63c5a06cf4c0373b5d044f2018bb6e1987c77f29"},{"sha":"6b108c3dfae0b11ec5e752cd43f2fe759698cd72","url":"https://api.github.com/repos/modelcontextprotocol/inspector/commits/6b108c3dfae0b11ec5e752cd43f2fe759698cd72","html_url":"https://github.com/modelcontextprotocol/inspector/commit/6b108c3dfae0b11ec5e752cd43f2fe759698cd72"}]},{"sha":"6b108c3dfae0b11ec5e752cd43f2fe759698cd72","node_id":"C_kwDOM7KEntoAKDZiMTA4YzNkZmFlMGIxMWVjNWU3NTJjZDQzZjJmZTc1OTY5OGNkNzI","commit":{"author":{"name":"cliffhall","email":"cliff@futurescale.com","date":"2026-10-21T17:45:36Z"},"committer":{"name":"cliffhall","email":"cliff@futurescale.com","date":"2026-10-21T17:45:36Z"},"message":"fix(core): keep the connection up when a request POST is HTTP-refused\n\nThe SDK's StreamableHTTP _send reports a failed POST through onerror and\nthen rethrows it to the sender. InspectorClient's onerror errored the\nwhole connection, so on the Node transport a refused subscriptions/listen\ntook the session down before #2722's refused stream status could show,\nand the TUI's 'Listen stream: refused by the server' was unreachable.\n\nA deterministic HTTP refusal (the #2722 classifier: ClientHttpNotImplemented\nwith 400/403/404/405, a code the SDK throws only from its POST path) now\nleaves the status alone; the request's rejection already surfaces it.\nEverything else reported through onerror still errors the connection.\n\nCloses #2776\n\nCo-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>\nSigned-off-by: cliffhall <cliff@futurescale.com>","tree":{"sha":"1724674b23b6b737a2899ac2b964b43a76e8c58f","url":"https://api.github.com/repos/modelcontextprotocol/inspector/git/trees/1724674b23b6b737a2899ac2b964b43a76e8c58f"},"url":"https://api.github.com/repos/modelcontextprotocol/inspector/git/commits/6b108c3dfae0b11ec5e752cd43f2fe759698cd72","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/modelcontextprotocol/inspector/commits/6b108c3dfae0b11ec5e752cd43f2fe759698cd72","html_url":"https://github.com/modelcontextprotocol/inspector/commit/6b108c3dfae0b11ec5e752cd43f2fe759698cd72","comments_url":"https://api.github.com/repos/modelcontextprotocol/inspector/commits/6b108c3dfae0b11ec5e752cd43f2fe759698cd72/comments","author":{"login":"cliffhall","id":871933,"node_id":"MDQ6VXNlcjg3MTkzMw==","avatar_url":"https://avatars.githubusercontent.com/u/871933?v=4","gravatar_id":"","url":"https://api.github.com/users/cliffhall","html_url":"https://github.com/cliffhall","followers_url":"https://api.github.com/users/cliffhall/followers","following_u